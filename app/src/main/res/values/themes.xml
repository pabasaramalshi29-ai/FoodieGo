<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FoodieGo" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.FoodieGo" parent="Base.Theme.FoodieGo" />

    <!-- Style for Rounded Images and Cards -->
    <style name="ShapeAppearance.FoodieGo.Card24" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">24dp</item>
    </style>
    <style name="ShapeAppearance.FoodieGo.Card16" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.FoodieGo.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">999dp</item>
    </style>
</resources>